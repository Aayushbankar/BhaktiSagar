# Bhakti Sagar – Apache configuration
# XAMPP ships with AllowOverride All, so this file is honoured as-is.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) The playback-verification harness (a static page, no data, no secrets) has to
  #    be reachable at the *same origin* the app runs on, because YouTube honours
  #    domain-restricted embedding. Everything else under tools/ stays blocked.
  RewriteRule ^tools/player-check\.html$ - [L]

  # 1) Never expose internal code or data.
  RewriteRule ^(config\.php|lib|data|tools|tests|db|docs|vendor)(/|$) - [F,L]

  # 2) Real files and directories (assets/, api/, index.php, ...) are served
  #    by Apache itself.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Everything else is a pretty URL -> the front controller.
  RewriteRule ^ index.php [L]
</IfModule>

# The JSON API must never be cached, everything else may be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(json)$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
